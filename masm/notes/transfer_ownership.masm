use miden_name::naming
use miden::protocol::active_note
use miden::core::sys

const NEW_OWNER_PTR=0

# Input (arguments): [NEW_OWNER]
begin
    push.0
    exec.active_note::get_storage
    drop drop
    mem_loadw_be.NEW_OWNER_PTR
